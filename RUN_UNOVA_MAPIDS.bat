# Persist all details before the time-consuming map scans/copy begin.
# Keep stdout visible as well as a local diagnostic file if a phase aborts.
class _Tee:
    def __init__(self,source,log):
        self.source=source
        self.log=log
    def write(self,value):
        self.source.write(value)
        self.source.flush()
        self.log.write(value)
        self.log.flush()
        return len(value)
    def flush(self):
        self.source.flush()
        self.log.flush()

_log_path=Path(os.environ.get("LOCALAPPDATA") or tempfile.gettempdir())/"PokemonBlueUnovaMapids"/"ULTIMA_EXECUCAO_A14.log"
try:
    _log_path.parent.mkdir(parents=True,exist_ok=True)
    _handle=_log_path.open("w",encoding="utf-8",buffering=1)
    sys.stdout=_Tee(sys.stdout,_handle)
    sys.stderr=_Tee(sys.stderr,_handle)
    print("[A13] Log de diagnostico: "+str(_log_path),flush=True)
except OSError as _log_error:
    print("[A13] Nao foi possivel criar log: "+str(_log_error),file=sys.stderr)

try:
    print("[A13] Validando e extraindo os 26 arquivos da ferramenta...",flush=True)
    raw = base64.b64decode("".join(BUNDLE_B64),validate=True)
    files = json.loads(raw.decode("utf-8"))
    if not isinstance(files,dict) or len(files)!=27:
        raise ValueError("Bundle incompleto")
    root_base=Path(os.environ.get("LOCALAPPDATA") or tempfile.gettempdir()).absolute()
    root=root_base/"PokemonBlueUnovaMapids"/("bundle-"+hashlib.sha256(raw).hexdigest()[:16])
    if root.is_symlink():
        raise ValueError("Pasta de cache inesperada")
    for key,content in files.items():
        path=PurePosixPath(key)
        if (path.is_absolute() or ".." in path.parts or not path.parts
            or any(part in ("", ".") for part in path.parts)
            or not isinstance(content,str)):
            raise ValueError("Arquivo incorreto no bundle")
        dest=root.joinpath(*path.parts)
        for parent in [root_base,root_base/"PokemonBlueUnovaMapids",*list(reversed(dest.parents))]:
            if parent.is_symlink():
                raise ValueError("Caminho de cache contem link")
        if dest.is_symlink():
            raise ValueError("Arquivo de cache alterado")
        dest.parent.mkdir(parents=True,exist_ok=True)
        data=content.encode("utf-8")
        if dest.exists():
            if not dest.is_file() or hashlib.sha256(dest.read_bytes()).digest()!=hashlib.sha256(data).digest():
                raise ValueError("Cache alterado; nenhum arquivo sera sobrescrito: "+str(dest))
        else:
            with dest.open("xb") as handle:
                handle.write(data)
    print("[A14] Ferramenta em cache verificada. Iniciando auditoria A04-A14...",flush=True)
    script=root/"scripts"/"regions"/"unova_auto_mapids.py"
    sys.path.insert(0,str(root))
    sys.path.insert(0,str(script.parent))
    sys.argv=[str(script),"--project",str(root),"--open-summary"]
    runpy.run_path(str(script),run_name="__main__")
except Exception as exc:
    print("UNOVA_PORTATIL_BLOQUEADO: "+str(exc),file=sys.stderr)
    print(traceback.format_exc(),file=sys.stderr)
    print("Envie o arquivo de diagnostico: "+str(_log_path),file=sys.stderr)
    sys.exit(2)
