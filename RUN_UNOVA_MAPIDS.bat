@echo off
setlocal EnableExtensions DisableDelayedExpansion
title POKEMON BLUE - UNOVA A04-A14 - SANDBOX
echo ============================================================
echo   UNOVA MAPIDS - VERSAO CORRIGIDA - UM DUPLO CLIQUE
echo   Pode executar diretamente da pasta Downloads
echo   Busca jogo e audita A04 a A14
echo   A13 valida copia QA; A14 prepara arquivo Windows Sandbox
echo ============================================================
echo   Nao abre Game.exe no host nem instala mapas Unova
echo.
set "PYRUN="
where py.exe >nul 2>nul
if not errorlevel 1 (
  py -3 -c "import sys;sys.exit(0 if sys.version_info >= (3,11) else 1)" >nul 2>nul
  if not errorlevel 1 set "PYRUN=py -3"
)
if not defined PYRUN (
  where python.exe >nul 2>nul
  if not errorlevel 1 (
    python -c "import sys;sys.exit(0 if sys.version_info >= (3,11) else 1)" >nul 2>nul
    if not errorlevel 1 set "PYRUN=python"
  )
)
if not defined PYRUN goto :missing_python
echo [A14] Python localizado. Preparando auditoria e Sandbox...
echo [A13] Log: %LOCALAPPDATA%\PokemonBlueUnovaMapids\ULTIMA_EXECUCAO_A14.log
%PYRUN% -u -c "import pathlib,sys;p=pathlib.Path(sys.argv[1]);s=p.read_text(encoding='utf-8-sig');m='::'+'BEGIN_UNOVA_PAYLOAD';a,b,c=s.partition(m);assert b,'Payload interno ausente';exec(compile(c.lstrip('\r\n'),str(p),'exec'),{'__name__':'__main__','__file__':str(p)})" "%~f0"
set "STATUS=%ERRORLEVEL%"
goto :end
:missing_python
echo [ERRO] Python 3.11 ou superior nao encontrado.
echo A ferramenta precisa de Python. Nenhum arquivo do jogo foi alterado.
set "STATUS=2"
:end
echo.
if "%STATUS%"=="0" (
    echo [OK] Verifique no TXT da A14 o local do arquivo .wsb.
) else (
    echo [ATENCAO] Um bloqueio ocorreu; confira o log A14 e o TXT.
)
echo O resumo sera aberto no Bloco de Notas quando possivel.
echo Log: %LOCALAPPDATA%\PokemonBlueUnovaMapids\ULTIMA_EXECUCAO_A14.log
echo Pressione qualquer tecla para fechar esta janela.
pause >nul
exit /b %STATUS%
